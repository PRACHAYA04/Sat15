<% content_for :title, "Taks" %>

<div class="min-h-screen bg-slate-950 px-4 py-10 text-slate-100 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <% if notice.present? %>
      <p class="mb-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm font-medium text-emerald-300"><%= notice %></p>
    <% end %>

    <div class="mb-8 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-500/20 text-2xl shadow-lg shadow-indigo-500/20">✅</span>
        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Taks</h1>
      </div>

      <%= link_to "➕ New tak", new_tak_path, class: "inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-indigo-500 to-violet-500 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-indigo-500/30 transition hover:translate-y-[-1px]" %>
    </div>

    <div id="taks" class="space-y-4">
      <% @taks.each do |tak| %>
        <%= render tak %>
      <% end %>
    </div>
  </div>
</div>
